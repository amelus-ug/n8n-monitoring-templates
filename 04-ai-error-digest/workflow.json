      "id": "8b413fc8-eb1c-446d-bbaa-d39ed93a6b45",
      "name": "List Failed Executions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1248,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "// Group the last LOOKBACK_HOURS of error executions by workflow.\nconst cfg = $('Config').first().json;\nconst lookbackHours = cfg.LOOKBACK_HOURS ?? 24;\nconst cutoff = Date.now() - lookbackHours * 3_600_000;\n\nconst body = $input.first().json;\nconst execs = (body.data || []).filter((e) => {\n  const t = new Date(e.startedAt || e.stoppedAt || 0).getTime();\n  return t >= cutoff;\n});\n\nconst groups = {};\nfor (const e of execs) {\n  const name = e.workflowData?.name ?? `workflow ${e.workflowId ?? '?'}`;\n  groups[name] = (groups[name] ?? 0) + 1;\n}\n\nconst total = execs.length;\nconst lines = Object.entries(groups)\n  .sort((a, b) => b[1] - a[1])\n  .map(([name, count]) => `- ${name}: ${count} failure(s)`);\n\nconst errorReport =\n  total === 0\n    ? `No failed executions in the last ${lookbackHours}h.`\n    : `Total failed executions in the last ${lookbackHours}h: ${total}\\nBy workflow (most failures first):\\n${lines.join('\\n')}`;\n\nreturn [{ json: { hasErrors: total > 0, total, lookbackHours, errorReport } }];"
      },
      "id": "083280c0-9de7-46aa-ae95-e39102520112",
      "name": "Aggregate Errors",
